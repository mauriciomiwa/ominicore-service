# /etc/ominicore${SUFIXO}/ominicore.env — gerado por deploy/aviva2/publicar.sh (${AMBIENTE}).
# Sem segredo: o client secret do Keycloak e a senha do Redis entram por podman secret.
OMINICORE_ADDR=0.0.0.0:8080
OMINICORE_BAO_ADDR=http://openbao:8200
OMINICORE_BAO_PREFIXO=${PREFIXO}
OMINICORE_BAO_ROLE=${ROLE}
OMINICORE_BAO_AUTH_MOUNT=${AUTH_MOUNT}
OMINICORE_KC_ISSUER=https://auth.flipapi.com.br/realms/${REALM}
OMINICORE_KC_URL=http://keycloak:8080
OMINICORE_KC_CLIENT_ID=ominicore-app
OMINICORE_REDIS_ADDR=redis:6379
OMINICORE_DB_SCHEMA=${SCHEMA}
OMINICORE_WEBHOOK_URL=https://${HOST_WEBHOOK}
# retenção (RN-9): igual em hml e prod
OMINICORE_RETENCAO_DIAS=30
TZ=America/Sao_Paulo
